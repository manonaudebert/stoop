# Neon (or any Postgres) connection string
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Socrata app token for NYC Open Data API (optional but avoids rate limits)
# Get one at: https://data.cityofnewyork.us/profile/app_tokens
SOCRATA_APP_TOKEN=your_socrata_token

# Shared secret between the API and the Next.js proxy
# Generate with: openssl rand -hex 32
INTERNAL_API_SECRET=your_internal_api_secret

# Comma-separated list of allowed CORS origins (defaults to localhost:3000)
# ALLOWED_ORIGINS=https://yourapp.vercel.app

# ── Observability (all optional; unset means the feature is simply off) ───────

# Set to 0/false to stop writing telemetry to the api_events table. The stdout
# JSON log is unaffected. Useful if the events write starts keeping Neon awake.
# EVENTS_DB_ENABLED=1

# 5xx alerts by email via Resend. Both must be set or alerting stays disabled,
# so local dev and CI never send mail. Throttled to one per exception-type +
# route per 15 minutes.
# RESEND_API_KEY=re_your_key
# ALERT_EMAIL=you@example.com
# ALERT_FROM=alerts@stoopcity.org
