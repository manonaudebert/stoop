# ── macOS ─────────────────────────────────────────────────────────────────────
.DS_Store

# ── Environment / secrets ─────────────────────────────────────────────────────
.env
# Neon branch connection strings, written during a migration test. Live
# credentials with the same access as prod — `.env` alone does NOT match these.
.env.branch
.env.*
!.env.example
frontend/.env.local
!frontend/.env.local.example

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
.venv/
.pytest_cache/

# ── Data files (large / generated — not part of source) ───────────────────────
data/raw/
data/clean/
data/sync.log
# Sync cursors are local-only, per-run state — CI defaults to a fixed lookback
# window when they're absent, so they must never be committed (a stale committed
# date would freeze the fetch window). Covers .last_sync{,_hpd,_hpd_complaints,_sf}.
data/.last_sync*

# ── Claude Code local settings ────────────────────────────────────────────────
.claude/settings.local.json

# ── Working / planning docs (local scratch, not shipped) ──────────────────────
SF_EXPANSION_PLAN.md
SF_MERGE_TODO.md

# Per-call cost/telemetry log from local brief runs
data/brief_calls.jsonl
.claude/
