# Mapbox public token (safe to expose in browser)
# Get one at: https://mapbox.com
NEXT_PUBLIC_MAPBOX_TOKEN=your_mapbox_token

# Neon (or any Postgres) connection string — used by Next.js auth routes
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# NextAuth secret — generate with: openssl rand -base64 32
AUTH_SECRET=your_auth_secret

# Internal FastAPI URL (server-side only, never exposed to browser)
INTERNAL_API_URL=http://localhost:8000

# Must match INTERNAL_API_SECRET in nyc-violations/.env
INTERNAL_API_SECRET=your_internal_api_secret
