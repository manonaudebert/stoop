<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.nycd.weekly-sync</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/manonaudebert/Documents/nycd/weekly_sync.sh</string>
    </array>

    <!-- Run every Sunday at 02:00 -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Weekday</key>
        <integer>0</integer>
        <key>Hour</key>
        <integer>2</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/manonaudebert/Documents/nycd/nyc-violations/data/sync_cron.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/manonaudebert/Documents/nycd/nyc-violations/data/sync_cron.log</string>

    <key>WorkingDirectory</key>
    <string>/Users/manonaudebert/Documents/nycd</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/usr/bin:/bin:/opt/homebrew/bin</string>
    </dict>
</dict>
</plist>
